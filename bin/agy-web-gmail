#!/usr/bin/env node
/**
 * Read and display Gmail emails synced with AGY Web Console.
 * Usage:
 *   agy-web-gmail
 *   agy-web-gmail --json
 *   agy-web-gmail --limit 10
 */

const port = process.env.PORT || '3080';
const baseUrl = `http://127.0.0.1:${port}`;

const args = process.argv.slice(2);
const isJson = args.includes('--json');
let limit = 20;
const limitIdx = args.findIndex((a) => a === '--limit' || a === '-n');
if (limitIdx !== -1 && args[limitIdx + 1]) {
  limit = parseInt(args[limitIdx + 1], 10) || 20;
}

(async () => {
  try {
    const res = await fetch(`${baseUrl}/api/gmail`);
    if (!res.ok) {
      throw new Error(`서버 응답 오류 (HTTP ${res.status})`);
    }
    const data = await res.json();

    if (isJson) {
      console.log(JSON.stringify(data, null, 2));
      process.exit(0);
    }

    const mails = Array.isArray(data?.mails) ? data.mails : [];
    const openMail = data?.openMail || null;

    if (mails.length === 0 && !openMail) {
      console.log('\x1b[33m[!] 현재 동기화된 지메일(Gmail) 데이터가 없습니다.\x1b[0m');
      console.log('연동 방법:');
      console.log('1. 브라우저에서 https://mail.google.com 에 접속합니다.');
      console.log('2. 웹 대시보드(http://127.0.0.1:3080) 상단의 [📧 지메일] 탭에서 북마크릿을 클릭하거나,');
      console.log('3. Chrome 확장을 로드하면 Gmail 탭을 열람할 때 자동으로 AGY 콘솔로 동기화됩니다.');
      process.exit(0);
    }

    console.log(`\x1b[36;1m📬 Gmail 받은편지함 (총 ${mails.length}건, 소스: ${data.source || 'sync'})\x1b[0m`);
    if (data.fetchedAt) {
      console.log(`\x1b[90m동기화 일시: ${new Date(data.fetchedAt).toLocaleString('ko-KR')}\x1b[0m\n`);
    }

    if (openMail) {
      console.log(`\x1b[32;1m📖 [열린 메일]\x1b[0m \x1b[1m${openMail.subject || '(제목 없음)'}\x1b[0m`);
      console.log(`  보낸사람: ${openMail.sender || '-'} | 일시: ${openMail.date || '-'}`);
      if (openMail.body) {
        console.log(`  본문 미리보기: ${openMail.body.slice(0, 300).replace(/\s+/g, ' ')}...\n`);
      }
    }

    const displayMails = mails.slice(0, limit);
    displayMails.forEach((m, idx) => {
      const badge = m.unread ? '\x1b[34;1m[안읽음]\x1b[0m' : '\x1b[90m[읽음]\x1b[0m';
      const sender = m.sender ? ` \x1b[33m<${m.sender}>\x1b[0m` : '';
      const date = m.date ? ` \x1b[90m(${m.date})\x1b[0m` : '';
      console.log(`${String(idx + 1).padStart(2, ' ')}. ${badge} \x1b[1m${m.subject}\x1b[0m${sender}${date}`);
      if (m.snippet) {
        console.log(`    \x1b[90m↳ ${m.snippet.slice(0, 100)}\x1b[0m`);
      }
    });

    if (mails.length > limit) {
      console.log(`\n\x1b[90m... 외 ${mails.length - limit}건이 더 있습니다. (--limit 으로 더 보기)\x1b[0m`);
    }
  } catch (err) {
    console.error('\x1b[31m[-] Gmail 조회 실패:\x1b[0m', err.message);
    process.exit(1);
  }
})();
