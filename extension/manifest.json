{
  "manifest_version": 3,
  "name": "AGY Web Console Bridge (Naver Mail, Cafe & Tabs)",
  "version": "1.1.0",
  "description": "현재 브라우저의 열린 탭 목록, 네이버 메일(mail.naver.com), 내가 가입한 네이버 카페(cafe.naver.com) 글 검색을 로컬 AGY Web Console(127.0.0.1:3080)과 실시간 동기화합니다.",
  "permissions": [
    "tabs",
    "scripting",
    "activeTab"
  ],
  "host_permissions": [
    "https://mail.naver.com/*",
    "https://mail.google.com/*",
    "https://cafe.naver.com/*",
    "https://section.cafe.naver.com/*",
    "https://apis.naver.com/*",
    "https://search.naver.com/*",
    "http://127.0.0.1:3080/*",
    "http://localhost:3080/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://mail.naver.com/*"],
      "js": ["content-naver-mail.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://mail.google.com/*"],
      "js": ["content-gmail.js"],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://section.cafe.naver.com/*",
        "https://cafe.naver.com/*"
      ],
      "js": ["content-naver-cafe.js"],
      "run_at": "document_idle",
      "all_frames": true
    }
  ]
}
